-- God Mode + Toggle Button + Strong Anti-Damage Item Protection
-- for Delta Executor

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local GOD_HEALTH = 9e9
local godModeEnabled = false
local connection
local damageHook

-- Create ScreenGui
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "GodModeGui"
ScreenGui.ResetOnSpawn = false
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

-- Main Button
local Button = Instance.new("TextButton")
Button.Name = "GodModeButton"
Button.Size = UDim2.new(0, 160, 0, 45)
Button.Position = UDim2.new(0.5, -80, 0.85, 0)
Button.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
Button.BorderSizePixel = 0
Button.Text = "God Mode: OFF"
Button.TextColor3 = Color3.fromRGB(255, 80, 80)
Button.TextScaled = true
Button.Font = Enum.Font.GothamBold
Button.Parent = ScreenGui

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 10)
UICorner.Parent = Button

local UIStroke = Instance.new("UIStroke")
UIStroke.Color = Color3.fromRGB(255, 80, 80)
UIStroke.Thickness = 2
UIStroke.Parent = Button

-- Force character fully visible
local function forceVisible(character)
    if not character then return end
    for _, part in pairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Transparency = 0
            part.LocalTransparencyModifier = 0
        elseif part:IsA("Decal") or part:IsA("Texture") then
            part.Transparency = 0
        end
    end
end

-- Strong God Mode protection
local function enableGodMode(character)
    if not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    -- High health
    humanoid.MaxHealth = GOD_HEALTH
    humanoid.Health = GOD_HEALTH

    -- Prevent death state
    humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
    humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
    humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)

    -- Block TakeDamage from most damage items
    if not damageHook then
        damageHook = humanoid.TakeDamage
        humanoid.TakeDamage = function() end  -- make TakeDamage do nothing
    end

    forceVisible(character)
end

-- Disable God Mode
local function disableGodMode(character)
    if not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    humanoid.MaxHealth = 100
    humanoid.Health = 100
    humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
    humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
    humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)

    -- Restore original TakeDamage if possible
    if damageHook then
        humanoid.TakeDamage = damageHook
        damageHook = nil
    end
end

-- Toggle
local function toggleGodMode()
    godModeEnabled = not godModeEnabled

    if godModeEnabled then
        Button.Text = "God Mode: ON"
        Button.TextColor3 = Color3.fromRGB(80, 255, 80)
        UIStroke.Color = Color3.fromRGB(80, 255, 80)

        if LocalPlayer.Character then
            enableGodMode(LocalPlayer.Character)
        end

        -- Continuous strong protection
        connection = RunService.Heartbeat:Connect(function()
            local char = LocalPlayer.Character
            if char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then
                    hum.MaxHealth = GOD_HEALTH
                    hum.Health = GOD_HEALTH
                    forceVisible(char)
                end
            end
        end)
    else
        Button.Text = "God Mode: OFF"
        Button.TextColor3 = Color3.fromRGB(255, 80, 80)
        UIStroke.Color = Color3.fromRGB(255, 80, 80)

        if connection then
            connection:Disconnect()
            connection = nil
        end

        if LocalPlayer.Character then
            disableGodMode(LocalPlayer.Character)
        end
    end
end

Button.MouseButton1Click:Connect(toggleGodMode)

-- Re-apply after respawn
LocalPlayer.CharacterAdded:Connect(function(character)
    task.wait(0.3)
    if godModeEnabled then
        enableGodMode(character)
    end
end)

print("Strong God Mode + Anti-Damage Item loaded")
